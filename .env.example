# Backend
APP_NAME=GitLab AI Content Engine
APP_ENV=development
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:5173
DATABASE_URL=postgresql+psycopg://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
AUTH_PROVIDER=firebase
FIREBASE_PROJECT_ID=your-firebase-project-id
# Optional: service account JSON as a single-line JSON value. Application Default Credentials also work.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Or point to a local service account JSON file (never commit that file).
FIREBASE_SERVICE_ACCOUNT_PATH=
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRE_MINUTES=1440

# AI provider: mock | openai_compatible
AI_PROVIDER=openai_compatible
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini
AI_TIMEOUT_SECONDS=120

# Optional GitLab integration
GITLAB_URL=https://gitlab.com
GITLAB_TOKEN=
GITLAB_PROJECT_ID=

# Optional CORS override
CORS_ORIGINS=http://localhost:5173
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
