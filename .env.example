# Backend
APP_NAME=GitLab AI Content Engine
APP_ENV=development
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:3000
DATABASE_URL=sqlite:///./data/app.db
AUTH_PROVIDER=firebase
FIREBASE_PROJECT_ID=your-firebase-project-id
# Optional: service account JSON as a single-line JSON value. Application Default Credentials also work.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Or point to a local service account JSON file (never commit that file).
FIREBASE_SERVICE_ACCOUNT_PATH=
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRE_MINUTES=1440

# AI provider: mock | openai_compatible
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini
AI_TIMEOUT_SECONDS=120
# true = CrewAI orchestrates the agents (real LLM only); falls back to the direct agent pipeline on failure
USE_CREWAI=true
# Optional: override where style guides / templates / sample docs live
KNOWLEDGE_DATA_DIR=
CHROMA_PERSIST_DIRECTORY=data/chroma

# Optional GitLab integration
GITLAB_URL=https://gitlab.com
GITLAB_TOKEN=
GITLAB_PROJECT_ID=

# Optional CORS override
# Comma-separated list. Add your deployed frontend URL, e.g. https://your-app.vercel.app
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
